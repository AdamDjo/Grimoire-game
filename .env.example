# ─────────────────────────────────────────
# Grimoire — Variables d'environnement
# Copier ce fichier en .env.local (frontend) et .env (backend)
# Ne jamais commiter .env ou .env.local
# ─────────────────────────────────────────

# ── Supabase ──────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://<project>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>   # backend uniquement, jamais exposé au frontend

# ── AI Providers ──────────────────────────
ANTHROPIC_API_KEY=<claude-api-key>             # dev uniquement
GOOGLE_GENERATIVE_AI_API_KEY=<gemini-api-key>  # prod primary (gratuit)
MISTRAL_API_KEY=<mistral-api-key>              # prod fallback

# ── Backend ───────────────────────────────
PORT=3001
NODE_ENV=development                           # development | production

# ── Frontend ──────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3001      # backend URL (dev)
# NEXT_PUBLIC_API_URL=https://api.grimoire.app  # prod

# ── Sécurité ──────────────────────────────
JWT_SECRET=<secret-32-chars-minimum>           # pour validation JWT côté backend
