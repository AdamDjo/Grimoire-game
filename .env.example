# ─────────────────────────────────────────
# Grimoire — Variables d'environnement
# Copier ce fichier en .env.local (frontend) et .env (backend)
# Ne jamais commiter .env ou .env.local
# Détail par app : apps/backend/.env.example, apps/frontend/.env.example
# ─────────────────────────────────────────

# ── Supabase ──────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://<project>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>
SUPABASE_URL=https://<project>.supabase.co     # backend
SUPABASE_SERVICE_KEY=<service-role-key>        # backend uniquement, jamais exposé au frontend

# ── Base de données (backend, via Prisma) ─
# DATABASE_URL passe par le pooler Supabase, DIRECT_URL par la connexion directe
# (les migrations ne peuvent pas passer par le pooler).
DATABASE_URL=postgresql://user:password@host:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://user:password@host:5432/postgres

# ── IA ────────────────────────────────────
OPENROUTER_API_KEY=sk-or-...                   # seul provider IA utilisé

# ── Backend ───────────────────────────────
PORT=3001
NODE_ENV=development                           # development | production
FRONTEND_URL=http://localhost:3000             # origine CORS autorisée

# ── Frontend ──────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3001      # backend URL (dev)
# NEXT_PUBLIC_API_URL=http://backend:3001      # prod : réseau interne, backend non exposé
