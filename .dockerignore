# Host node_modules are platform-specific (macOS binaries) and would overwrite
# the Linux ones installed inside the image.
node_modules
**/node_modules

# Build output — regenerated inside the image.
dist
.next
**/dist
**/.next
**/.turbo

# The Prisma client is generated by the postinstall hook inside the image.
apps/backend/src/generated

# Secrets must never enter the build context.
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example

.git
.github
docs
coverage
**/coverage
cypress/videos
cypress/screenshots
*.log
.DS_Store
